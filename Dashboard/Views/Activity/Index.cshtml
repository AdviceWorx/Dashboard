<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>

    /* =========================================================
       GLOBAL STATE
       ========================================================= */

    let reportPeriod = "daily";
    let reportDate = "";

    let allRecords = [];
    let filteredRecords = [];

    let allUsers = [];
    let filteredUsers = [];

    const charts = {};

    const COLORS = {
        red: "#D64545",
        blue: "#2563EB",
        yellow: "#EAB308",
        dark: "#1F2937",
        grey: "#6B7280",
        green: "#16A34A"
    };


    /* =========================================================
       INIT
       ========================================================= */

    document.addEventListener("DOMContentLoaded", function() {

        const today = new Date();

        document.getElementById("reportDate").value =
            formatDateInput(today);

        document.getElementById("periodSelect").value =
            "daily";

        bindEvents();

        loadDashboard();
    });


    /* =========================================================
       EVENTS
       ========================================================= */

    function bindEvents() {

        document
            .getElementById("periodSelect")
            .addEventListener("change", function() {

                reportPeriod = this.value;

                updatePeriodButtons();

                loadDashboard();
            });


        document
            .getElementById("reportDate")
            .addEventListener("change", function() {

                loadDashboard();
            });


        document
            .getElementById("groupFilter")
            .addEventListener("change", applyFilters);


        document
            .getElementById("branchFilter")
            .addEventListener("change", applyFilters);


        document
            .getElementById("locationFilter")
            .addEventListener("change", applyFilters);


        document
            .getElementById("userFilter")
            .addEventListener("change", applyFilters);


        document
            .getElementById("searchUser")
            .addEventListener("input", applyFilters);


        document
            .querySelectorAll(".period-btn")
            .forEach(btn => {

                btn.addEventListener("click", function() {

                    reportPeriod =
                        this.dataset.period;

                    document
                        .getElementById("periodSelect")
                        .value = reportPeriod;

                    updatePeriodButtons();

                    loadDashboard();
                });

            });


        document
            .getElementById("contributionModal")
            .addEventListener("click", function(e) {

                if (e.target === this) {
                    closeContributionModal();
                }

            });


        document
            .getElementById("userModal")
            .addEventListener("click", function(e) {

                if (e.target === this) {
                    closeUserModal();
                }

            });


        document.addEventListener("keydown", function(e) {

            if (e.key === "Escape") {

                closeContributionModal();
                closeUserModal();

            }

        });

    }


    /* =========================================================
       LOAD
       ========================================================= */

    async function loadDashboard() {

        showLoading(true);
        hideError();

        reportPeriod =
            document.getElementById("periodSelect").value;

        reportDate =
            document.getElementById("reportDate").value;

        try {

            const url =
                `/api/activity?period=${encodeURIComponent(reportPeriod)}&date=${encodeURIComponent(reportDate)}`;

            const response =
                await fetch(url, {
                    headers: {
                        "Accept": "application/json"
                    }
                });

            if (!response.ok) {
                throw new Error(
                    `API returned HTTP ${response.status}`
                );
            }

            const payload =
                await response.json();

            /*
             * Supports:
             *
             * [...]
             *
             * OR
             *
             * {
             *   data: [...]
             * }
             */

            if (Array.isArray(payload)) {

                allRecords = payload;

            } else if (Array.isArray(payload.data)) {

                allRecords = payload.data;

            } else if (Array.isArray(payload.users)) {

                allRecords = payload.users;

            } else {

                allRecords = [];

            }

            normalizeRecords();

            allUsers =
                aggregateUsers(allRecords);

            populateFilters();

            applyFilters();

            updatePeriodDescription(payload);

        } catch (error) {

            console.error(error);

            showError(
                "Unable to load activity data. " +
                error.message
            );

            allRecords = [];
            filteredRecords = [];
            allUsers = [];
            filteredUsers = [];

            clearDashboard();

        } finally {

            showLoading(false);

        }

    }


    /* =========================================================
       NORMALIZE
       ========================================================= */

    function normalizeRecords() {

        allRecords =
            allRecords.map(x => ({

                ...x,

                user_name:
                    x.user_name ??
                    x.UserName ??
                    "",

                user_group:
                    x.user_group ??
                    x.UserGroup ??
                    "",

                job_title:
                    x.job_title ??
                    x.JobTitle ??
                    "",

                device_name:
                    x.device_name ??
                    x.DeviceName ??
                    "",

                work_hours:
                    num(x.work_hours ??
                        x.WorkHours),

                active_hours:
                    num(x.active_hours ??
                        x.ActiveHours),

                downtime_hours:
                    num(x.downtime_hours ??
                        x.DowntimeHours),

                m365_hours:
                    num(x.m365_hours ??
                        x.M365Hours),

                interactive_events:
                    num(x.interactive_events ??
                        x.InteractiveEvents),

                location_verdict:
                    x.location_verdict ??
                    x.LocationVerdict ??
                    "",

                office_branch:
                    x.office_branch ??
                    x.OfficeBranch ??
                    "",

                city:
                    x.city ??
                    x.City ??
                    "",

                region:
                    x.region ??
                    x.Region ??
                    "",

                isp:
                    x.isp ??
                    x.ISP ??
                    "",

                connection_type:
                    x.connection_type ??
                    x.ConnectionType ??
                    "",

                first_public_ip:
                    x.first_public_ip ??
                    x.FirstPublicIP ??
                    "",

                last_public_ip:
                    x.last_public_ip ??
                    x.LastPublicIP ??
                    "",

                ip_changes:
                    num(x.ip_changes ??
                        x.IPChanges),

                xplan_sessions:
                    num(x.xplan_sessions ??
                        x.XplanSessions),

                xplan_hours:
                    num(x.xplan_hours ??
                        x.XplanHours),

                xplan_resources:
                    num(x.xplan_resources ??
                        x.XplanResources),

                xplan_overnight_sessions:
                    num(x.xplan_overnight_sessions ??
                        x.XplanOvernightSessions),

                xplan_after_hours_sessions:
                    num(x.xplan_after_hours_sessions ??
                        x.XplanAfterHoursSessions),

                anomaly_flags:
                    x.anomaly_flags ??
                    x.AnomalyFlags ??
                    "",

                flag_count:
                    num(x.flag_count ??
                        x.FlagCount),

                prev_day_work_hours:
                    num(x.prev_day_work_hours ??
                        x.PreviousDayWorkHours),

                work_hours_change:
                    num(x.work_hours_change ??
                        x.WorkHoursChange),

                new_user:
                    Boolean(
                        x.new_user ??
                        x.NewUser
                    ),

                research_note:
                    x.research_note ??
                    x.ResearchNote ??
                    "",

                report_date:
                    x.report_date ??
                    x.ReportDate ??
                    x.date ??
                    x.Date ??
                    reportDate

            }));

    }


    /* =========================================================
       AGGREGATE USERS
       ========================================================= */

    function aggregateUsers(records) {

        const map = new Map();

        records.forEach(r => {

            const key =
                String(r.user_name || "Unknown");

            if (!map.has(key)) {

                map.set(key, {

                    user_name: key,

                    user_group: r.user_group || "",

                    job_title: r.job_title || "",

                    device_name: r.device_name || "",

                    work_hours: 0,

                    active_hours: 0,

                    downtime_hours: 0,

                    m365_hours: 0,

                    interactive_events: 0,

                    location_verdict:
                        r.location_verdict || "",

                    office_branch:
                        r.office_branch || "",

                    city:
                        r.city || "",

                    region:
                        r.region || "",

                    isp:
                        r.isp || "",

                    connection_type:
                        r.connection_type || "",

                    first_public_ip:
                        r.first_public_ip || "",

                    last_public_ip:
                        r.last_public_ip || "",

                    ip_changes: 0,

                    xplan_sessions: 0,

                    xplan_hours: 0,

                    xplan_resources: 0,

                    xplan_overnight_sessions: 0,

                    xplan_after_hours_sessions: 0,

                    flag_count: 0,

                    anomaly_flags: [],

                    previous_day_work_hours: 0,

                    work_hours_change: 0,

                    new_user: false,

                    research_note: ""

                });

            }

            const u = map.get(key);

            u.work_hours += num(r.work_hours);
            u.active_hours += num(r.active_hours);
            u.downtime_hours += num(r.downtime_hours);
            u.m365_hours += num(r.m365_hours);
            u.interactive_events += num(r.interactive_events);

            u.ip_changes += num(r.ip_changes);

            u.xplan_sessions += num(r.xplan_sessions);
            u.xplan_hours += num(r.xplan_hours);
            u.xplan_resources += num(r.xplan_resources);

            u.xplan_overnight_sessions +=
                num(r.xplan_overnight_sessions);

            u.xplan_after_hours_sessions +=
                num(r.xplan_after_hours_sessions);

            u.flag_count += num(r.flag_count);

            if (r.anomaly_flags) {

                if (Array.isArray(r.anomaly_flags)) {

                    u.anomaly_flags.push(
                        ...r.anomaly_flags
                    );

                } else {

                    u.anomaly_flags.push(
                        String(r.anomaly_flags)
                    );

                }

            }

            u.previous_day_work_hours =
                num(r.prev_day_work_hours);

            u.work_hours_change +=
                num(r.work_hours_change);

            u.new_user =
                u.new_user || Boolean(r.new_user);

            if (r.research_note) {
                u.research_note =
                    r.research_note;
            }

        });

        return Array.from(map.values())
            .map(u => {

                u.utilisation =
                    u.work_hours > 0
                        ? (u.active_hours /
                            u.work_hours) * 100
                        : 0;

                return u;

            })
            .sort((a, b) =>
                a.user_name.localeCompare(
                    b.user_name
                )
            );

    }


    /* =========================================================
       FILTERS
       ========================================================= */

    function populateFilters() {

        fillSelect(
            "groupFilter",
            uniqueValues(
                allUsers.map(x => x.user_group)
            )
        );

        fillSelect(
            "branchFilter",
            uniqueValues(
                allUsers.map(x => x.office_branch)
            )
        );

        fillSelect(
            "locationFilter",
            uniqueValues(
                allUsers.map(x => x.location_verdict)
            )
        );

        fillSelect(
            "userFilter",
            uniqueValues(
                allUsers.map(x => x.user_name)
            )
        );

    }


    function fillSelect(id, values) {

        const select =
            document.getElementById(id);

        const previous =
            select.value;

        const firstOption =
            select.options[0].text;

        select.innerHTML = "";

        const empty =
            document.createElement("option");

        empty.value = "";
        empty.textContent = firstOption;

        select.appendChild(empty);

        values.forEach(value => {

            if (!value) return;

            const option =
                document.createElement("option");

            option.value = value;
            option.textContent = value;

            select.appendChild(option);

        });

        if (
            values.includes(previous)
        ) {
            select.value = previous;
        }

    }


    function applyFilters() {

        const group =
            document.getElementById(
                "groupFilter"
            ).value;

        const branch =
            document.getElementById(
                "branchFilter"
            ).value;

        const location =
            document.getElementById(
                "locationFilter"
            ).value;

        const user =
            document.getElementById(
                "userFilter"
            ).value;

        const search =
            document.getElementById(
                "searchUser"
            ).value
                .trim()
                .toLowerCase();


        filteredRecords =
            allRecords.filter(r => {

                if (
                    group &&
                    r.user_group !== group
                ) return false;

                if (
                    branch &&
                    r.office_branch !== branch
                ) return false;

                if (
                    location &&
                    r.location_verdict !== location
                ) return false;

                if (
                    user &&
                    r.user_name !== user
                ) return false;

                if (
                    search &&
                    !String(r.user_name)
                        .toLowerCase()
                        .includes(search)
                ) return false;

                return true;

            });


        filteredUsers =
            aggregateUsers(filteredRecords);


        updateKpis();

        renderCharts();

        renderWorkforceTable();

    }


    /* =========================================================
       KPI
       ========================================================= */

    function updateKpis() {

        const users =
            filteredUsers;

        const work =
            sum(users, "work_hours");

        const active =
            sum(users, "active_hours");

        const downtime =
            sum(users, "downtime_hours");

        const xplan =
            sum(users, "xplan_hours");

        const sessions =
            sum(users, "xplan_sessions");

        const flags =
            sum(users, "flag_count");

        const afterHours =
            sum(
                users,
                "xplan_after_hours_sessions"
            );

        const overnight =
            sum(
                users,
                "xplan_overnight_sessions"
            );

        const ipChanges =
            sum(users, "ip_changes");

        const utilisation =
            work > 0
                ? active / work * 100
                : 0;

        const flaggedUsers =
            users.filter(
                x => num(x.flag_count) > 0
            ).length;


        setText(
            "kpiUsers",
            users.length
        );

        setText(
            "kpiWork",
            formatNumber(work)
        );

        setText(
            "kpiActive",
            formatNumber(active)
        );

        setText(
            "kpiDowntime",
            formatNumber(downtime)
        );

        setText(
            "kpiUtilisation",
            formatNumber(utilisation) + "%"
        );

        setText(
            "kpiXplan",
            formatNumber(xplan)
        );

        setText(
            "kpiXplanSessions",
            formatNumber(sessions, 0)
        );

        setText(
            "kpiFlags",
            formatNumber(flags, 0)
        );

        setText(
            "kpiAfterHours",
            formatNumber(afterHours, 0)
        );

        setText(
            "kpiOvernight",
            formatNumber(overnight, 0)
        );

        setText(
            "kpiIpChanges",
            formatNumber(ipChanges, 0)
        );

        setText(
            "kpiFlaggedUsers",
            flaggedUsers
        );

    }


    /* =========================================================
       CHARTS
       ========================================================= */

    function renderCharts() {

        destroyCharts();

        createWorkActivityChart();

        createUtilisationChart();

        createXplanChart();

        createXplanEngagementChart();

        createAnomalyChart();

        createLocationChart();

        createBranchChart();

        createGroupChart();

        createJobTitleChart();

        createWorkDistributionChart();

        createAfterHoursChart();

        createOvernightChart();

        createIpChart();

        createTimeDistributionChart();

        createActivityMatrixChart();

    }


    /* =========================================================
       WORK / ACTIVE / DOWNTIME
       ========================================================= */

    function createWorkActivityChart() {

        const data =
            getTrendData();

        charts.workActivityChart =
            new Chart(
                document.getElementById(
                    "workActivityChart"
                ),
                {
                    type: "bar",

                    data: {

                        labels: data.labels,

                        datasets: [

                            {
                                label: "Work Hours",
                                data: data.work,
                                backgroundColor:
                                    COLORS.blue,
                                borderRadius: 5
                            },

                            {
                                label: "Active Hours",
                                data: data.active,
                                backgroundColor:
                                    COLORS.yellow,
                                borderRadius: 5
