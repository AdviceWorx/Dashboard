    /* =========================================================
       TREND DATA
       ========================================================= */

    function getTrendData() {

        /*
         * DAILY
         *
         * Show each user.
         */

        if (reportPeriod === "daily") {

            const users =
                [...filteredUsers]
                    .sort(
                        (a, b) =>
                            b.work_hours -
                            a.work_hours
                    )
                    .slice(0, 30);

            return {

                keys:
                    users.map(
                        x => x.user_name
                    ),

                labels:
                    users.map(
                        x => x.user_name
                    ),

                work:
                    users.map(
                        x => x.work_hours
                    ),

                active:
                    users.map(
                        x => x.active_hours
                    ),

                downtime:
                    users.map(
                        x => x.downtime_hours
                    ),

                utilisation:
                    users.map(
                        x => x.utilisation
                    ),

                xplan:
                    users.map(
                        x => x.xplan_hours
                    ),

                sessions:
                    users.map(
                        x => x.xplan_sessions
                    ),

                flags:
                    users.map(
                        x => x.flag_count
                    )

            };

        }


        /*
         * WEEKLY
         *
         * Monday -> Sunday.
         */

        if (reportPeriod === "weekly") {

            const days = [];

            const selected =
                parseDateOnly(reportDate);

            if (!selected) {
                return emptyTrend();
            }

            const day =
                selected.getDay();

            const mondayOffset =
                day === 0
                    ? -6
                    : 1 - day;

            const monday =
                new Date(selected);

            monday.setDate(
                monday.getDate() +
                mondayOffset
            );

            for (
                let i = 0;
                i < 7;
                i++
            ) {

                const d =
                    new Date(monday);

                d.setDate(
                    monday.getDate() + i
                );

                const key =
                    formatDateInput(d);

                const records =
                    filteredRecords.filter(
                        r =>
                            dateKey(
                                r.report_date
                            ) === key
                    );

                const users =
                    aggregateUsers(records);

                days.push({

                    key,

                    label:
                        d.toLocaleDateString(
                            "en-ZA",
                            {
                                weekday: "short",
                                day: "2-digit"
                            }
                        ),

                    work:
                        sum(users, "work_hours"),

                    active:
                        sum(users, "active_hours"),

                    downtime:
                        sum(users, "downtime_hours"),

                    xplan:
                        sum(users, "xplan_hours"),

                    sessions:
                        sum(users, "xplan_sessions"),

                    flags:
                        sum(users, "flag_count"),

                    utilisation:
                        sum(users, "work_hours") > 0
                            ? (
                                sum(
                                    users,
                                    "active_hours"
                                ) /
                                sum(
                                    users,
                                    "work_hours"
                                )
                            ) * 100
                            : 0

                });

            }

            return {

                keys:
                    days.map(x => x.key),

                labels:
                    days.map(x => x.label),

                work:
                    days.map(x => x.work),

                active:
                    days.map(x => x.active),

                downtime:
                    days.map(x => x.downtime),

                utilisation:
                    days.map(x => x.utilisation),

                xplan:
                    days.map(x => x.xplan),

                sessions:
                    days.map(x => x.sessions),

                flags:
                    days.map(x => x.flags)

            };

        }


        /*
         * MONTHLY
         *
         * Week 1 -> Week 5.
         */

        const selected =
            parseDateOnly(reportDate);

        if (!selected) {
            return emptyTrend();
        }

        const year =
            selected.getFullYear();

        const month =
            selected.getMonth();

        const weeks = [];

        for (
            let week = 1;
            week <= 5;
            week++
        ) {

            const records =
                filteredRecords.filter(
                    r => {

                        const d =
                            parseDateOnly(
                                dateKey(
                                    r.report_date
                                )
                            );

                        if (!d)
                            return false;

                        return (
                            d.getFullYear() === year &&
                            d.getMonth() === month &&
                            Math.floor(
                                (d.getDate() - 1) / 7
                            ) + 1 === week
                        );

                    }
                );

            const users =
                aggregateUsers(records);

            weeks.push({

                key:
                    "Week " + week,

                label:
                    "Week " + week,

                work:
                    sum(users, "work_hours"),

                active:
                    sum(users, "active_hours"),

                downtime:
                    sum(users, "downtime_hours"),

                xplan:
                    sum(users, "xplan_hours"),

                sessions:
                    sum(users, "xplan_sessions"),

                flags:
                    sum(users, "flag_count"),

                utilisation:
                    sum(users, "work_hours") > 0
                        ? (
                            sum(
                                users,
                                "active_hours"
                            ) /
                            sum(
                                users,
                                "work_hours"
                            )
                        ) * 100
                        : 0

            });

        }

        return {

            keys:
                weeks.map(x => x.key),

            labels:
                weeks.map(x => x.label),

            work:
                weeks.map(x => x.work),

            active:
                weeks.map(x => x.active),

            downtime:
                weeks.map(x => x.downtime),

            utilisation:
                weeks.map(x => x.utilisation),

            xplan:
                weeks.map(x => x.xplan),

            sessions:
                weeks.map(x => x.sessions),

            flags:
                weeks.map(x => x.flags)

        };

    }


    function emptyTrend() {

        return {

            keys: [],
            labels: [],
            work: [],
            active: [],
            downtime: [],
            utilisation: [],
            xplan: [],
            sessions: [],
            flags: []

        };

    }


    /* =========================================================
       TREND CLICK
       ========================================================= */

    function handleTrendClick(
        key,
        metric,
        label
    ) {

        /*
         * DAILY:
         * key is actually username.
         */

        if (reportPeriod === "daily") {

            openContributionForUser(
                key,
                metric,
                label
            );

            return;
        }


        /*
         * WEEKLY:
         * key = YYYY-MM-DD.
         */

        if (reportPeriod === "weekly") {

            const records =
                filteredRecords.filter(
                    r =>
                        dateKey(
                            r.report_date
                        ) === key
                );

            const date =
                parseDateOnly(key);

            const title =
                `${label} — ${date ? date.toLocaleDateString("en-ZA", {
                    weekday: "long",
                    day: "2-digit",
                    month: "long",
                    year: "numeric"
                }) : key}`;

            openContributionModal(
                title,
                metric,
                records,
                metricLabel(metric)
            );

            return;
        }


        /*
         * MONTHLY:
         * key = Week 1 etc.
         */

        if (reportPeriod === "monthly") {

            const weekNumber =
                parseInt(
                    String(key)
                        .replace("Week ", "")
                );

            const selected =
                parseDateOnly(reportDate);

            const records =
                filteredRecords.filter(
                    r => {

                        const d =
                            parseDateOnly(
                                dateKey(
                                    r.report_date
                                )
                            );

                        if (!d || !selected)
                            return false;

                        return (
                            d.getFullYear() ===
                            selected.getFullYear() &&

                            d.getMonth() ===
                            selected.getMonth() &&

                            Math.floor(
                                (d.getDate() - 1) / 7
                            ) + 1 === weekNumber
                        );

                    }
                );

            openContributionModal(
                "Week " + weekNumber,
                metric,
                records,
                metricLabel(metric)
            );

        }

    }


    /* =========================================================
       CONTRIBUTION MODAL
       ========================================================= */

    function openContributionModal(
        title,
        metric,
        records,
        metricText
    ) {

        /*
         * THIS IS THE IMPORTANT FIX.
         *
         * Always aggregate the raw records here.
         * Never depend on an already rendered chart.
         */

        const users =
            aggregateContributionUsers(
                records,
                metric
            );


        const total =
            users.reduce(
                (sum, x) =>
                    sum + x.value,
                0
            );


        const average =
            users.length > 0
                ? total / users.length
                : 0;


        document.getElementById(
            "contributionTitle"
        ).textContent =
            title;


        document.getElementById(
            "contributionSubtitle"
        ).textContent =
            `Users contributing to ${metricText}`;


        document.getElementById(
            "contributionTotal"
        ).textContent =
            formatMetricValue(
                total,
                metric
            );


        document.getElementById(
            "contributionUsers"
        ).textContent =
            users.length;


        document.getElementById(
            "contributionAverage"
        ).textContent =
            formatMetricValue(
                average,
                metric
            );


        document.getElementById(
            "contributionMetric"
        ).textContent =
            metricText;


        const tbody =
            document.getElementById(
                "contributionTableBody"
            );


        /*
         * Clear old rows BEFORE inserting new ones.
         */

        tbody.innerHTML = "";


        if (!users.length) {

            const tr =
                document.createElement("tr");

            const td =
                document.createElement("td");

            td.colSpan = 6;

            td.className =
                "empty-contribution";

            td.textContent =
                "No users contributed to this result.";

            tr.appendChild(td);

            tbody.appendChild(tr);

        } else {

            users.forEach(user => {

                const tr =
                    document.createElement("tr");

                tr.dataset.user =
                    user.user_name;


                tr.innerHTML = `

                        <td>
                            <span class="user-link contributor-user">
                                ${escapeHtml(user.user_name)}
                            </span>
                        </td>

                        <td>
                            ${escapeHtml(
                    formatMetricValue(
                        user.value,
                        metric
                    )
                )}
                        </td>

                        <td>
                            <span class="badge badge-blue">
                                ${user.percentage.toFixed(1)}%
                            </span>
                        </td>

                        <td>
                            ${escapeHtml(
                    user.user_group || "—"
                )}
                        </td>

                        <td>
                            ${escapeHtml(
                    user.office_branch || "—"
                )}
                        </td>

                        <td>
                            ${escapeHtml(
                    user.job_title || "—"
                )}
                        </td>

                    `;


                tr.addEventListener(
                    "click",
                    function() {

                        openUserModal(
                            user.user_name
                        );

                    }
                );


                tbody.appendChild(tr);

            });

        }


        /*
         * Populate everything FIRST.
         * Then show modal.
         */

        const modal =
            document.getElementById(
                "contributionModal"
            );

        modal.classList.add("show");

        document.body.style.overflow =
            "hidden";

    }


    function openContributionForUser(
        userName,
        metric,
        metricText
    ) {

        const records =
            filteredRecords.filter(
                r =>
                    String(
                        r.user_name
                    ) === String(userName)
            );


        openContributionModal(
            userName,
            metric,
            records,
            metricText
        );

    }


    function openContributionForCategory(
        title,
        records,
        metricText
    ) {

        /*
         * For categories such as Branch, Group
         * and Location, show work contribution
         * when "Users" is not a numeric metric.
         */

        const metric =
            metricText === "Users"
                ? "user_count"
                : "work_hours";


        const users =
            records.map(r => ({
                ...r,
                user_count: 1
            }));


        if (metric === "user_count") {

            const unique =
                aggregateUsers(
                    records
                );

            openContributionModal(
                title,
                "user_count",
                unique.map(u => ({
                    ...u,
                    user_count: 1
                })),
                "Users"
            );

        } else {

            openContributionModal(
                title,
                "work_hours",
                users,
                "Work Hours"
            );

        }

    }


    function aggregateContributionUsers(
        records,
        metric
    ) {

        const map =
            new Map();


        records.forEach(r => {

            const name =
                String(
                    r.user_name ||
                    "Unknown"
                );


            if (!map.has(name)) {

                map.set(name, {

                    user_name: name,

                    user_group:
                        r.user_group || "",

                    office_branch:
                        r.office_branch || "",

                    job_title:
                        r.job_title || "",

                    value: 0

                });

            }


            const item =
                map.get(name);


            let value = 0;


            if (metric === "utilisation") {

                /*
                 * For utilisation across
                 * multiple records, use
                 * active / work later.
                 */

                value +=
                    num(r.active_hours);

            } else if (
                metric === "user_count"
            ) {

                value = 1;

            } else {

                value =
                    num(
                        r[metric]
                    );

            }


            item.value += value;

        });


        let users =
            Array.from(
                map.values()
            );


        /*
         * For utilisation,
         * calculate weighted utilisation.
         */

        if (
            metric ===
            "utilisation"
        ) {

            const grouped =
                new Map();


            records.forEach(r => {

                const name =
                    String(
                        r.user_name ||
                        "Unknown"
                    );


                if (!grouped.has(name)) {

                    grouped.set(
                        name,
                        {
                            active: 0,
                            work: 0
                        }
                    );

                }


                const g =
                    grouped.get(name);


                g.active +=
                    num(r.active_hours);

                g.work +=
                    num(r.work_hours);

            });


            users =
                users.map(u => {

                    const g =
                        grouped.get(
                            u.user_name
                        );


                    return {

                        ...u,

                        value:
                            g && g.work > 0
                                ? (
                                    g.active /
                                    g.work
                                ) * 100
                                : 0

                    };

                });

        }


        const total =
            users.reduce(
                (sum, x) =>
                    sum + x.value,
                0
            );


        users =
            users.map(u => ({

                ...u,

                percentage:
                    total > 0
                        ? (
                            u.value /
                            total
                        ) * 100
                        : 0

            }));


        users.sort(
            (a, b) =>
                b.value -
                a.value
        );


        return users;

    }


