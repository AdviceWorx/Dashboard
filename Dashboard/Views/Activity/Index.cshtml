    }


    /* =========================================================
       PDF
       ========================================================= */

    function exportDashboardPdf() {

        const element =
            document.querySelector(
                ".dashboard"
            );

        const filename =
            `activity-dashboard-${reportPeriod}-${reportDate}.pdf`;

        html2pdf()
            .set({

                margin: 0.25,

                filename,

                image: {
                    type: "jpeg",
                    quality: 0.95
                },

                html2canvas: {
                    scale: 1.5,
                    useCORS: true
                },

                jsPDF: {
                    unit: "in",
                    format: "a4",
                    orientation: "landscape"
                }

            })
            .from(element)
            .save();

    }

</script>