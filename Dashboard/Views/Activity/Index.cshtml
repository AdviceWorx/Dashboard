        setText("kpiDowntime", "0");
        setText("kpiUtilisation", "0%");
        setText("kpiXplan", "0");
        setText("kpiXplanSessions", "0");
        setText("kpiFlags", "0");
        setText("kpiAfterHours", "0");
        setText("kpiOvernight", "0");
        setText("kpiIpChanges", "0");
        setText("kpiFlaggedUsers", "0");

