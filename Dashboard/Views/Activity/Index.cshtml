@model Dashboard.Models.ActivityDashboardViewModel

@{
    ViewData["Title"] = "Enterprise Activity Dashboard";
}

<style>
    :root {
        --red: #D64545;
        --blue: #2563EB;
        --yellow: #EAB308;
        --dark: #1F2937;
        --dark-2: #374151;
        --grey: #6B7280;
        --light-grey: #F3F4F6;
        --border: #E5E7EB;
        --white: #FFFFFF;
        --red-light: #FEE2E2;
        --blue-light: #DBEAFE;
        --yellow-light: #FEF3C7;
        --green: #16A34A;
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #F7F8FA;
        color: var(--dark);
    }

    .dashboard {
        max-width: 1800px;
        margin: 0 auto;
        padding: 24px;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .dashboard-header {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 24px 28px;
        margin-bottom: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }

    .header-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .header-title h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .header-title p {
        margin: 7px 0 0;
        color: var(--grey);
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        border: 0;
        border-radius: 9px;
        padding: 10px 15px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .btn-primary {
        background: var(--blue);
        color: white;
    }

    .btn-dark {
        background: var(--dark);
        color: white;
    }

    .btn-light {
        background: var(--light-grey);
        color: var(--dark);
        border: 1px solid var(--border);
    }

    /* =========================================================
           FILTERS
           ========================================================= */

    .filters {
        display: grid;
        grid-template-columns: 150px 180px repeat(4, minmax(150px, 1fr)) auto;
        gap: 12px;
        align-items: end;
        margin-top: 22px;
    }

    .filter-group label {
        display: block;
        font-size: 11px;
        font-weight: 800;
        color: var(--grey);
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 6px;
    }

    .filter-group select,
    .filter-group input {
        width: 100%;
        height: 40px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: white;
        padding: 0 11px;
        color: var(--dark);
        outline: none;
    }

        .filter-group select:focus,
        .filter-group input:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(37,99,235,.10);
        }

    /* =========================================================
           PERIOD BAR
           ========================================================= */

    .period-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

    .period-buttons {
        display: flex;
        background: white;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 4px;
    }

    .period-btn {
        border: 0;
        background: transparent;
        padding: 9px 18px;
        border-radius: 7px;
        font-weight: 700;
        color: var(--grey);
        cursor: pointer;
    }

        .period-btn.active {
            background: var(--dark);
            color: white;
        }

    .period-description {
        font-size: 13px;
        color: var(--grey);
    }

    /* =========================================================
           LOADING / ERROR
           ========================================================= */

    .status-box {
        display: none;
        background: white;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
        text-align: center;
    }

        .status-box.show {
            display: block;
        }

    .status-error {
        color: var(--red);
        background: var(--red-light);
        border-color: #FCA5A5;
    }

    /* =========================================================
           KPI
           ========================================================= */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
        margin-bottom: 22px;
    }

    .kpi {
        background: white;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px;
        min-height: 120px;
        box-shadow: 0 3px 12px rgba(0,0,0,.025);
        position: relative;
        overflow: hidden;
    }

        .kpi::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            height: 4px;
            width: 100%;
        }

        .kpi.blue::after {
            background: var(--blue);
        }

        .kpi.red::after {
            background: var(--red);
        }

        .kpi.yellow::after {
            background: var(--yellow);
        }

    .kpi-title {
        font-size: 11px;
        text-transform: uppercase;
        color: var(--grey);
        font-weight: 800;
        letter-spacing: .4px;
    }

    .kpi-value {
        margin-top: 10px;
        font-size: 27px;
        font-weight: 800;
        color: var(--dark);
    }

    .kpi-sub {
        margin-top: 5px;
        font-size: 11px;
        color: var(--grey);
    }

    /* =========================================================
           SECTION
           ========================================================= */

    .section {
        margin-bottom: 22px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 800;
        margin: 0;
    }

    .section-note {
        color: var(--grey);
        font-size: 12px;
    }

    /* =========================================================
           CHART GRID
           ========================================================= */

    .chart-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .chart-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 15px;
        padding: 18px;
        min-height: 360px;
        box-shadow: 0 3px 12px rgba(0,0,0,.025);
    }

        .chart-card.full {
            grid-column: 1 / -1;
        }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .chart-title {
        font-size: 14px;
        font-weight: 800;
        margin: 0;
    }

    .chart-hint {
        font-size: 10px;
        color: var(--grey);
        margin-top: 3px;
    }

    .chart-container {
        position: relative;
        height: 290px;
    }

        .chart-container.small {
            height: 250px;
        }

    /* =========================================================
           TABLE
           ========================================================= */

    .table-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 15px;
        overflow: hidden;
    }

    .table-toolbar {
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

        .table-toolbar h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 800;
        }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    th {
        background: #F9FAFB;
        color: var(--grey);
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: .4px;
        font-weight: 800;
        padding: 12px 14px;
        text-align: left;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }

    td {
        padding: 12px 14px;
        border-bottom: 1px solid #F0F1F3;
        white-space: nowrap;
    }

    tr:hover td {
        background: #FAFBFC;
    }

    .user-link {
        color: var(--blue);
        font-weight: 800;
        cursor: pointer;
    }

    .badge {
        display: inline-flex;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
    }

    .badge-blue {
        background: var(--blue-light);
        color: #1D4ED8;
    }

    .badge-red {
        background: var(--red-light);
        color: #B91C1C;
    }

    .badge-yellow {
        background: var(--yellow-light);
        color: #A16207;
    }

    /* =========================================================
           MODALS
           ========================================================= */

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(17,24,39,.68);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 25px;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal {
        width: min(1100px, 96vw);
        max-height: 92vh;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,.25);
        display: flex;
        flex-direction: column;
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

        .modal-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 800;
        }

        .modal-header p {
            margin: 5px 0 0;
            font-size: 12px;
            color: var(--grey);
        }

    .modal-close {
        border: 0;
        background: var(--light-grey);
        width: 34px;
        height: 34px;
        border-radius: 8px;
        font-size: 20px;
        cursor: pointer;
        color: var(--dark);
    }

    .modal-body {
        padding: 22px;
        overflow-y: auto;
    }

    /* =========================================================
           CONTRIBUTION MODAL
           ========================================================= */

    .contribution-modal {
        width: min(1200px, 96vw);
    }

    .contribution-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: #F9FAFB;
        border: 1px solid var(--border);
        border-radius: 11px;
        padding: 14px;
    }

        .summary-card .label {
            font-size: 10px;
            text-transform: uppercase;
            color: var(--grey);
            font-weight: 800;
        }

        .summary-card .value {
            margin-top: 6px;
            font-size: 22px;
            font-weight: 800;
        }

    .contribution-table tbody tr {
        cursor: pointer;
    }

        .contribution-table tbody tr:hover td {
            background: var(--blue-light);
        }

    .empty-contribution {
        text-align: center;
        padding: 40px;
        color: var(--grey);
    }

    /* =========================================================
           USER DETAIL
           ========================================================= */

    .user-detail-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    .detail-card {
        background: #F9FAFB;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 14px;
    }

        .detail-card .label {
            font-size: 10px;
            text-transform: uppercase;
            color: var(--grey);
            font-weight: 800;
        }

        .detail-card .value {
            margin-top: 6px;
            font-size: 16px;
            font-weight: 800;
        }

    .detail-section {
        margin-top: 22px;
    }

        .detail-section h3 {
            font-size: 14px;
            margin-bottom: 10px;
        }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media(max-width: 1300px) {
        .filters {
            grid-template-columns: repeat(4, 1fr);
        }

        .kpi-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media(max-width: 900px) {
        .dashboard {
            padding: 12px;
        }

        .header-top {
            flex-direction: column;
        }

        .chart-grid {
            grid-template-columns: 1fr;
        }

        .chart-card.full {
            grid-column: auto;
        }

        .filters {
            grid-template-columns: repeat(2, 1fr);
        }

        .contribution-summary,
        .user-detail-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media(max-width: 600px) {
        .filters,
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .period-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .period-buttons {
            width: 100%;
        }

        .period-btn {
            flex: 1;
        }

        .contribution-summary,
        .user-detail-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="dashboard-header">

        <div class="header-top">

            <div class="header-title">
                <h1>Enterprise Activity Dashboard</h1>
                <p>
                    Workforce activity, productivity, Xplan usage,
                    location intelligence and risk analytics.
                </p>
            </div>

            <div class="header-actions">
                <button class="btn btn-light" onclick="loadDashboard()">
                    ↻ Refresh
                </button>

                <button class="btn btn-dark" onclick="exportDashboardPdf()">
                    Export PDF
                </button>
            </div>

        </div>

        <div class="filters">

            <div class="filter-group">
                <label>Period</label>
                <select id="periodSelect">
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                    <option value="monthly">Monthly</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Date</label>
                <input type="date" id="reportDate" />
            </div>

            <div class="filter-group">
                <label>User Group</label>
                <select id="groupFilter">
                    <option value="">All Groups</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Office Branch</label>
                <select id="branchFilter">
                    <option value="">All Branches</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Location</label>
                <select id="locationFilter">
                    <option value="">All Locations</option>
                </select>
            </div>

            <div class="filter-group">
                <label>User</label>
                <select id="userFilter">
                    <option value="">All Users</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Search</label>
                <input type="text"
                       id="searchUser"
                       placeholder="Search user..." />
            </div>

        </div>

    </div>

    <!-- =====================================================
         STATUS
         ===================================================== -->

    <div id="loadingBox" class="status-box">
        Loading activity data...
    </div>

    <div id="errorBox" class="status-box status-error">
    </div>

    <!-- =====================================================
         PERIOD
         ===================================================== -->

    <div class="period-bar">

        <div class="period-buttons">
            <button class="period-btn active" data-period="daily">
                Daily
            </button>

            <button class="period-btn" data-period="weekly">
                Weekly
            </button>

            <button class="period-btn" data-period="monthly">
                Monthly
            </button>
        </div>

        <div id="periodDescription" class="period-description">
            Daily activity
        </div>

    </div>

    <!-- =====================================================
         KPI
         ===================================================== -->

    <div class="kpi-grid">

        <div class="kpi blue">
            <div class="kpi-title">Users</div>
            <div class="kpi-value" id="kpiUsers">0</div>
            <div class="kpi-sub">Unique workforce users</div>
        </div>

        <div class="kpi blue">
            <div class="kpi-title">Work Hours</div>
            <div class="kpi-value" id="kpiWork">0.00</div>
            <div class="kpi-sub">Total recorded hours</div>
        </div>

        <div class="kpi blue">
            <div class="kpi-title">Active Hours</div>
            <div class="kpi-value" id="kpiActive">0.00</div>
            <div class="kpi-sub">Active computer time</div>
        </div>

        <div class="kpi red">
            <div class="kpi-title">Downtime</div>
            <div class="kpi-value" id="kpiDowntime">0.00</div>
            <div class="kpi-sub">Recorded inactive time</div>
        </div>

        <div class="kpi blue">
            <div class="kpi-title">Utilisation</div>
            <div class="kpi-value" id="kpiUtilisation">0%</div>
            <div class="kpi-sub">Active / Work</div>
        </div>

        <div class="kpi yellow">
            <div class="kpi-title">Xplan Hours</div>
            <div class="kpi-value" id="kpiXplan">0.00</div>
            <div class="kpi-sub">Xplan activity</div>
        </div>

        <div class="kpi yellow">
            <div class="kpi-title">Xplan Sessions</div>
            <div class="kpi-value" id="kpiXplanSessions">0</div>
            <div class="kpi-sub">Recorded sessions</div>
        </div>

        <div class="kpi red">
            <div class="kpi-title">Risk Flags</div>
            <div class="kpi-value" id="kpiFlags">0</div>
            <div class="kpi-sub">Anomaly signals</div>
        </div>

        <div class="kpi red">
            <div class="kpi-title">After Hours</div>
            <div class="kpi-value" id="kpiAfterHours">0</div>
            <div class="kpi-sub">After-hours sessions</div>
        </div>

        <div class="kpi red">
            <div class="kpi-title">Overnight</div>
            <div class="kpi-value" id="kpiOvernight">0</div>
            <div class="kpi-sub">Overnight sessions</div>
        </div>

        <div class="kpi yellow">
            <div class="kpi-title">IP Changes</div>
            <div class="kpi-value" id="kpiIpChanges">0</div>
            <div class="kpi-sub">Network changes</div>
        </div>

        <div class="kpi red">
            <div class="kpi-title">Flagged Users</div>
            <div class="kpi-value" id="kpiFlaggedUsers">0</div>
            <div class="kpi-sub">Users with flags</div>
        </div>

    </div>

    <!-- =====================================================
         MANAGEMENT SUMMARY
         ===================================================== -->

    <div class="section">

        <div class="section-header">
            <div>
                <h2 class="section-title">Management Analytics</h2>
                <div class="section-note">
                    Click any chart column, bar or segment to see the users contributing to that result.
                </div>
            </div>
        </div>

        <div class="chart-grid">

            <!-- 1 -->
            <div class="chart-card full">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Work vs Active vs Downtime
                        </h3>
                        <div class="chart-hint">
                            Click a column to view contributing users
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="workActivityChart"></canvas>
                </div>
            </div>

            <!-- 2 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Productivity Utilisation
                        </h3>
                        <div class="chart-hint">
                            Click to inspect users
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="utilisationChart"></canvas>
                </div>
            </div>

            <!-- 3 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Xplan Usage
                        </h3>
                        <div class="chart-hint">
                            Click to inspect contributing users
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="xplanChart"></canvas>
                </div>
            </div>

            <!-- 4 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Xplan Engagement
                        </h3>
                        <div class="chart-hint">
                            Click any bar
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="xplanEngagementChart"></canvas>
                </div>
            </div>

            <!-- 5 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Risk & Anomaly Signals
                        </h3>
                        <div class="chart-hint">
                            Click a result to see contributing users
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="anomalyChart"></canvas>
                </div>
            </div>

            <!-- 6 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Location Verdict
                        </h3>
                        <div class="chart-hint">
                            Click a segment
                        </div>
                    </div>
                </div>

                <div class="chart-container small">
                    <canvas id="locationChart"></canvas>
                </div>
            </div>

            <!-- 7 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Branch Performance
                        </h3>
                        <div class="chart-hint">
                            Click a branch
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="branchChart"></canvas>
                </div>
            </div>

            <!-- 8 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            User Group Performance
                        </h3>
                        <div class="chart-hint">
                            Click a group
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="groupChart"></canvas>
                </div>
            </div>

            <!-- 9 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Job Title Distribution
                        </h3>
                        <div class="chart-hint">
                            Click a job title
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="jobTitleChart"></canvas>
                </div>
            </div>

            <!-- 10 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Work Hours Distribution
                        </h3>
                        <div class="chart-hint">
                            Click a user
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="workDistributionChart"></canvas>
                </div>
            </div>

            <!-- 11 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            After-Hours Activity
                        </h3>
                        <div class="chart-hint">
                            Click a user
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="afterHoursChart"></canvas>
                </div>
            </div>

            <!-- 12 -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 class="chart-title">
                            Overnight Activity
                        </h3>
                        <div class="chart-hint">
                            Click a user
                        </div>
                    </div>
                </div>

